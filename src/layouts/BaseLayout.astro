---
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import Nav from '../components/Nav.astro';
import CutoffBanner from '../components/CutoffBanner.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description = 'Personalised 3D prints, made in Toronto. Lithophanes, LED name signs, QR stands, garage mounts and custom builds.', ogImage = '/og-default.jpg', noindex = false } = Astro.props;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <Analytics position="head" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f2ee" />
    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-mono" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <Analytics position="body" />
    <a href="#main-content" class="sr-only">Skip to content</a>
    <Nav />
    <CutoffBanner />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <script>
      import { rememberCampaign } from '../lib/analytics';
      rememberCampaign();
      import { startMotion } from '../lib/motion';
      import { startSwipers } from '../lib/swipers';
      startMotion();
      startSwipers();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
