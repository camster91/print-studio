---
interface Props { items: { q: string; a: string }[]; id?: string; title?: string; kicker?: string }
const { items, id = 'faq', title = 'Questions, answered', kicker = 'FAQ' } = Astro.props;
---

<section class="section faq" id={id}>
  <div class="container faq__grid">
    <div class="stack gap-16">
      <p class="mono-m kicker">{kicker}</p>
      <h2 class="display-m" data-reveal>{title}</h2>
    </div>
    <div class="faq__items">
      {items.map((it, i) => (
        <details open={i === 0} data-reveal>
          <summary class="label-l">{it.q}<span aria-hidden="true" class="faq__icon">+</span></summary>
          <p class="body-m">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; grid-template-columns: 420px 1fr; gap: 80px; }
  details { border-bottom: 1px solid var(--grid); padding-block: 22px; }
  summary { display: flex; justify-content: space-between; gap: 16px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .faq__icon { color: var(--accent-ink); font-size: 1.5rem; line-height: 1; transition: transform 250ms var(--ease); }
  details[open] .faq__icon { transform: rotate(45deg); }
  details p { margin-top: 12px; max-width: 720px; }
  @media (max-width: 991px) { .faq__grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
