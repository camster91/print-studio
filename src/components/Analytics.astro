---
import {site} from '../config/site';
interface Props {position:'head'|'body'}
const {position}=Astro.props;
const {gtmId,ga4Id}=site.analytics;
const configured=!!(gtmId || ga4Id);
---
{position === 'head' && configured && <script is:inline define:vars={{gtmId,ga4Id}}>
(function(){
  let loaded=false;
  function load(){
    let accepted=false;try{accepted=localStorage.getItem('layerline-analytics-consent')==='yes';}catch{}
    if(!accepted || loaded)return;
    loaded=true;window.dataLayer=window.dataLayer||[];
    const script=document.createElement('script');script.async=true;
    if(/^GTM-[A-Z0-9]+$/.test(gtmId)){
      window.dataLayer.push({'gtm.start':Date.now(),event:'gtm.js'});script.src='https://www.googletagmanager.com/gtm.js?id='+encodeURIComponent(gtmId);
    }else if(/^G-[A-Z0-9]+$/.test(ga4Id)){
      window.gtag=function(){window.dataLayer.push(arguments);};window.gtag('js',new Date());window.gtag('config',ga4Id);script.src='https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(ga4Id);
    }else return;
    document.head.append(script);
  }
  window.addEventListener('analytics:consent',load);load();
})();
</script>}
{position === 'body' && configured && <aside class="consent" data-analytics-consent hidden aria-label="Optional analytics">
  <p>May we use optional analytics to see which products and channels help people order? Your choice does not affect checkout. <a href="/policies#privacy">Privacy details</a></p>
  <button class="btn btn--dark" data-analytics-yes>Allow analytics</button><button class="btn" data-analytics-no>Keep optional analytics off</button>
</aside>}
{position === 'body' && configured && <button class="analytics-choice" data-analytics-choices>Analytics choices</button>}
<script>
const banner=document.querySelector<HTMLElement>('[data-analytics-consent]');
if(banner){
  let stored:string|null=null;try{stored=localStorage.getItem('layerline-analytics-consent');}catch{}
  banner.hidden=stored!==null;
  document.querySelector('[data-analytics-choices]')?.addEventListener('click',()=>{banner.hidden=false;});
  banner.querySelector('[data-analytics-yes]')?.addEventListener('click',()=>{try{localStorage.setItem('layerline-analytics-consent','yes');}catch{}banner.hidden=true;window.dispatchEvent(new Event('analytics:consent'));});
  banner.querySelector('[data-analytics-no]')?.addEventListener('click',()=>{try{localStorage.setItem('layerline-analytics-consent','no');}catch{}location.reload();});
}
</script>
<style>.consent{position:fixed;bottom:20px;left:20px;right:20px;z-index:100;background:var(--paper);border:1px solid var(--grid);border-radius:16px;padding:20px;box-shadow:0 4px 24px #0003;display:flex;flex-wrap:wrap;gap:16px;align-items:center}.consent[hidden]{display:none}.consent p{flex:1 1 300px}.consent a{text-decoration:underline}.analytics-choice{position:fixed;bottom:4px;right:12px;z-index:50;font-size:.75rem;background:var(--paper);padding:4px}</style>
