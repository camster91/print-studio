---
import Stars from './Stars.astro';
import TopBar from './TopBar.astro';
import ProductTabs from './ProductTabs.astro';
import { site } from '../config/site';
import { noOrphan } from '../lib/typography';

const views = [
  { src: '/assets/images/product-green.avif', srcset: '/assets/images/product-green-768.avif 768w, /assets/images/product-green.avif 1206w', w: 1206, h: 804, thumbW: 94, thumbH: 63, alt: 'Sola Stride sneaker in green, side view' },
  { src: '/assets/images/angle-top.avif', w: 291, h: 552, thumbW: 59, thumbH: 112, alt: 'Sola Stride sneaker seen from above' },
  { src: '/assets/images/angle-back.avif', w: 271, h: 313, thumbW: 77, thumbH: 89, alt: 'Sola Stride sneaker seen from the back' },
  { src: '/assets/images/angle-side.avif', w: 580, h: 316, thumbW: 97, thumbH: 53, alt: 'Sola Stride sneaker, inner side view' },
];

const colors = [
  { id: 'green', name: 'Green', src: '/assets/images/swatch-green.avif', fit: '79.41%' },
  { id: 'black', name: 'Black', src: '/assets/images/swatch-black.avif', fit: '73.8%' },
  { id: 'white', name: 'White', src: '/assets/images/swatch-white.avif', fit: '76.42%' },
  { id: 'red', name: 'Red', src: '/assets/images/swatch-red.avif', fit: '79.04%' },
];

const sizes = [
  { label: '6 uk', soldOut: true },
  { label: '6.5 uk', soldOut: true },
  { label: '7 uk', selected: true },
  { label: '7.5 uk' },
  { label: '8 uk' },
  { label: '8.5 uk' },
  { label: '9 uk' },
  { label: '9.5 uk' },
  { label: '10 uk', soldOut: true },
  { label: '10.5 uk', soldOut: true },
];

const payments = [
  { src: '/assets/icons/pay-1.svg', w: 18, h: 20 },
  { src: '/assets/icons/pay-2.svg', w: 24, h: 20 },
  { src: '/assets/icons/pay-3.svg', w: 20, h: 20 },
  { src: '/assets/icons/pay-4.svg', w: 21, h: 20 },
  { src: '/assets/icons/pay-5.svg', w: 24, h: 20 },
];

const details = ['Lightweight cushioning', 'Breathable upper', 'Flexible outsole', 'Durable everyday traction'];
const delivery = ['Free US shipping on every order', 'Ships within 1–2 business days', 'Arrives in 3–5 business days', 'Tracking link sent by email'];
const returns = ['100 days to return or exchange', 'Free size exchanges', 'Prepaid return label included', 'Refund within 5 business days'];
---

<section class="hero" aria-label="Sola Stride">
  <TopBar />
  <div class="hero__body">
  <div class="hero__panel">
    <div class="hero__gallery">
      <div class="hero__thumbs" role="tablist" aria-label="Product views">
        {
          views.map((view, i) => (
            <button
              class="hero__thumb"
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={view.alt}
              data-index={i}
            >
              <img src={view.src} alt="" width={view.thumbW} height={view.thumbH} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </button>
          ))
        }
      </div>
      <div class="hero__stage">
        <div class="hero__track">
          {
            views.map((view, i) => (
              <div class="hero__slide">
                <img
                  src={view.src}
                  srcset={view.srcset}
                  sizes={view.srcset ? '(min-width: 768px) 603px, calc(100vw - 16px)' : undefined}
                  alt={view.alt}
                  width={view.w}
                  height={view.h}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </div>
            ))
          }
        </div>
        <div class="hero__dots" aria-hidden="true">
          {views.map((_, i) => <span class={i === 0 ? 'hero__dot is-active' : 'hero__dot'} />)}
        </div>
      </div>
    </div>

    <div class="hero__buy">
      <div class="hero__head">
        <div class="hero__rating">
          <Stars src="/assets/icons/star.svg" />
          <p class="t-meta">80,000+ reviews</p>
        </div>
        <h1 class="hero__title t-display">Sola Stride</h1>
        <p class="hero__text t-body">
          {noOrphan('A versatile everyday sneaker designed to keep your feet comfortable, supported, and ready for whatever the day brings.')}
        </p>
        <div class="hero__price">
          <s class="hero__was t-price">{site.price.was}</s>
          <span class="hero__now t-price">{site.price.now}</span>
          <span class="hero__badge t-tag">{site.discount}% off</span>
        </div>
      </div>

      <div class="hero__group" data-reveal>
        <p class="hero__label t-label">Select Colors</p>
        <div class="hero__colors">
          {
            colors.map((color, i) => (
              <button
                class="hero__color"
                type="button"
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-label={color.name}
                style={`--fit: ${color.fit}`}
                data-cart-option
                data-id={color.id}
                data-name={color.name}
                data-image={color.src}
              >
                <img src={color.src} alt="" width="240" height="160" loading="lazy" decoding="async" />
              </button>
            ))
          }
        </div>
      </div>

      <div class="hero__group" data-reveal>
        <div class="hero__label-row t-label">
          <p>Select Size</p>
          <button class="hero__link hit" type="button" data-open-tab="size-guide">Size guide</button>
        </div>
        <div class="hero__sizes">
          {
            sizes.map((size) => (
              <button
                class="hero__size hit hit--tight t-cta"
                type="button"
                aria-pressed={size.selected ? 'true' : 'false'}
                disabled={size.soldOut}
                aria-label={size.soldOut ? `${size.label} (sold out)` : size.label}
                data-cart-option
                data-id={size.label.replace(/\s+/g, '-')}
                data-name={size.label.toUpperCase()}
              >
                {size.label}
              </button>
            ))
          }
        </div>
        <p class="hero__note t-small">
          <img src="/assets/icons/warning.svg" alt="" width="16" height="16" />
          <span><strong>True to size.</strong> {noOrphan('We recommend ordering your usual size.')}</span>
        </p>
      </div>

      <div class="hero__purchase" data-reveal>
        <div class="hero__cta-row">
          <button
            type="button"
            class="hero__cta btn btn--primary t-cta"
            data-add-to-cart
            data-track="cta-hero"
            data-cue
            data-id={site.product.id}
            data-name={site.product.name}
            data-price={site.product.price}
            data-image={site.product.image}
          >
            <span class="btn__label">
              <span>Add to bag</span><span class="hero__cta-price">- {site.price.now}&nbsp;<s>({site.price.was})</s></span>
            </span>
            <span class="btn__done" aria-hidden="true">
              <img src="/assets/icons/check.svg" alt="" width="16" height="16" />
              Added
            </span>
          </button>
          <button class="hero__wish" type="button" aria-label="Add to wishlist" aria-pressed="false" data-favorite={site.product.id}>
            <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
              <path class="hero__wish-fill" d="M21.6328 6.64689C21.3187 5.91947 20.8657 5.26029 20.2992 4.70627C19.7323 4.15058 19.064 3.70898 18.3305 3.40549C17.5699 3.08951 16.7541 2.92778 15.9305 2.9297C14.775 2.9297 13.6477 3.24611 12.668 3.84377C12.4336 3.98674 12.2109 4.14377 12 4.31486C11.7891 4.14377 11.5664 3.98674 11.332 3.84377C10.3523 3.24611 9.225 2.9297 8.06953 2.9297C7.2375 2.9297 6.43125 3.08908 5.66953 3.40549C4.93359 3.71017 4.27031 4.14845 3.70078 4.70627C3.13357 5.25966 2.68047 5.919 2.36719 6.64689C2.04141 7.40392 1.875 8.20783 1.875 9.03517C1.875 9.81564 2.03438 10.6289 2.35078 11.4563C2.61563 12.1477 2.99531 12.8649 3.48047 13.5891C4.24922 14.7352 5.30625 15.9305 6.61875 17.1422C8.79375 19.1508 10.9477 20.5383 11.0391 20.5945L11.5945 20.9508C11.8406 21.1078 12.157 21.1078 12.4031 20.9508L12.9586 20.5945C13.05 20.536 15.2016 19.1508 17.3789 17.1422C18.6914 15.9305 19.7484 14.7352 20.5172 13.5891C21.0023 12.8649 21.3844 12.1477 21.6469 11.4563C21.9633 10.6289 22.1227 9.81564 22.1227 9.03517C22.125 8.20783 21.9586 7.40392 21.6328 6.64689Z" />
              <path d="M21.6328 6.64689C21.3187 5.91947 20.8657 5.26029 20.2992 4.70627C19.7323 4.15058 19.064 3.70898 18.3305 3.40549C17.5699 3.08951 16.7541 2.92778 15.9305 2.9297C14.775 2.9297 13.6477 3.24611 12.668 3.84377C12.4336 3.98674 12.2109 4.14377 12 4.31486C11.7891 4.14377 11.5664 3.98674 11.332 3.84377C10.3523 3.24611 9.225 2.9297 8.06953 2.9297C7.2375 2.9297 6.43125 3.08908 5.66953 3.40549C4.93359 3.71017 4.27031 4.14845 3.70078 4.70627C3.13357 5.25966 2.68047 5.919 2.36719 6.64689C2.04141 7.40392 1.875 8.20783 1.875 9.03517C1.875 9.81564 2.03438 10.6289 2.35078 11.4563C2.61563 12.1477 2.99531 12.8649 3.48047 13.5891C4.24922 14.7352 5.30625 15.9305 6.61875 17.1422C8.79375 19.1508 10.9477 20.5383 11.0391 20.5945L11.5945 20.9508C11.8406 21.1078 12.157 21.1078 12.4031 20.9508L12.9586 20.5945C13.05 20.536 15.2016 19.1508 17.3789 17.1422C18.6914 15.9305 19.7484 14.7352 20.5172 13.5891C21.0023 12.8649 21.3844 12.1477 21.6469 11.4563C21.9633 10.6289 22.1227 9.81564 22.1227 9.03517C22.125 8.20783 21.9586 7.40392 21.6328 6.64689ZM12 19.0969C12 19.0969 3.65625 13.7508 3.65625 9.03517C3.65625 6.64689 5.63203 4.71095 8.06953 4.71095C9.78281 4.71095 11.2687 5.6672 12 7.06408C12.7313 5.6672 14.2172 4.71095 15.9305 4.71095C18.368 4.71095 20.3438 6.64689 20.3438 9.03517C20.3438 13.7508 12 19.0969 12 19.0969Z" />
            </svg>
          </button>
        </div>
        <ul class="hero__payments" aria-label="Payment methods">
          {
            payments.map((pay) => (
              <li class="hero__pay">
                <img src={pay.src} alt="" width={pay.w} height={pay.h} />
              </li>
            ))
          }
        </ul>
        <div class="hero__perks t-small">
          <p><img src="/assets/icons/shipping.svg" alt="" width="20" height="20" />100 days hassle-free returns</p>
          <p><img src="/assets/icons/flag-us.svg" alt="" width="20" height="20" />Free US shipping included</p>
        </div>
      </div>

      <div class="hero__warranty" data-reveal>
        <img src="/assets/icons/shield.svg" alt="" width="52" height="52" />
        <div>
          <p class="hero__warranty-title t-card">1-year warranty</p>
          <p class="t-small">{noOrphan('On all products')}</p>
        </div>
      </div>
    </div>

    <div class="hero__more">
      <ProductTabs />

      <div class="hero__accordions" data-reveal>
        <details class="hero__acc" open>
          <summary class="hero__acc-head hit">
            <img class="hero__acc-icon hero__acc-icon--list" src="/assets/icons/list.svg" alt="" width="28" height="28" />
            <span class="t-card">Product details</span>
            <img class="hero__caret" src="/assets/icons/caret.svg" alt="" width="24" height="24" />
          </summary>
          <div class="hero__acc-panel">
          <div class="hero__acc-body">
            <ul class="hero__list t-body">
              {details.map((item) => <li>{noOrphan(item)}</li>)}
            </ul>
            <a class="hero__link hit t-meta" href="#details">Learn more</a>
          </div>
          </div>
        </details>
        <details class="hero__acc">
          <summary class="hero__acc-head hit">
            <img class="hero__acc-icon" src="/assets/icons/box.svg" alt="" width="32" height="32" />
            <span class="t-card">{noOrphan('Get your delivery date')}</span>
            <img class="hero__caret" src="/assets/icons/caret.svg" alt="" width="24" height="24" />
          </summary>
          <div class="hero__acc-panel">
          <div class="hero__acc-body">
            <ul class="hero__list t-body">
              {delivery.map((item) => <li>{noOrphan(item)}</li>)}
            </ul>
          </div>
          </div>
        </details>
        <details class="hero__acc">
          <summary class="hero__acc-head hit">
            <img class="hero__acc-icon" src="/assets/icons/cube.svg" alt="" width="32" height="32" />
            <span class="t-card">EASY RETURNS</span>
            <img class="hero__caret" src="/assets/icons/caret.svg" alt="" width="24" height="24" />
          </summary>
          <div class="hero__acc-panel">
          <div class="hero__acc-body">
            <ul class="hero__list t-body">
              {returns.map((item) => <li>{noOrphan(item)}</li>)}
            </ul>
          </div>
          </div>
        </details>
      </div>
    </div>
  </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('.hero__track');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.hero__thumb')];
  const dots = [...document.querySelectorAll<HTMLElement>('.hero__dot')];

  const mark = (index: number) => {
    thumbs.forEach((thumb, i) => thumb.setAttribute('aria-selected', String(i === index)));
    dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
  };

  if (track) {
    thumbs.forEach((thumb, i) =>
      thumb.addEventListener('click', () => {
        track.scrollTo({ left: i * track.clientWidth, behavior: 'instant' });
        mark(i);
      }),
    );
    let frame = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => mark(Math.round(track.scrollLeft / track.clientWidth)));
      },
      { passive: true },
    );
  }

  const single = (selector: string) => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(selector)];
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      }),
    );
  };

  const DURATION = 450;
  const EASING = 'cubic-bezier(0.33, 1, 0.68, 1)';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const accordions = [...document.querySelectorAll<HTMLDetailsElement>('details.hero__acc')];
  const running = new Map<HTMLDetailsElement, Animation>();
  const panelOf = (item: HTMLDetailsElement) => item.querySelector<HTMLElement>('.hero__acc-panel')!;

  const animate = (item: HTMLDetailsElement, from: number, to: number, done?: () => void) => {
    running.get(item)?.cancel();
    if (reduced.matches) {
      done?.();
      return;
    }
    const anim = panelOf(item).animate({ height: [`${from}px`, `${to}px`] }, { duration: DURATION, easing: EASING });
    running.set(item, anim);
    anim.onfinish = () => {
      running.delete(item);
      done?.();
    };
  };

  const close = (item: HTMLDetailsElement) => {
    if (!item.open || item.classList.contains('is-closing')) return;
    item.classList.add('is-closing');
    animate(item, panelOf(item).offsetHeight, 0, () => {
      item.open = false;
      item.classList.remove('is-closing');
    });
  };

  let pin = 0;
  const holdInPlace = (item: HTMLDetailsElement) => {
    cancelAnimationFrame(pin);
    const head = item.querySelector('summary')!;
    let last = head.getBoundingClientRect().top;
    const end = performance.now() + DURATION + 50;
    const step = () => {
      const top = head.getBoundingClientRect().top;
      if (top !== last) window.scrollBy({ top: top - last, behavior: 'instant' });
      last = head.getBoundingClientRect().top;
      if (performance.now() < end) pin = requestAnimationFrame(step);
    };
    pin = requestAnimationFrame(step);
  };

  const open = (item: HTMLDetailsElement) => {
    const from = item.classList.contains('is-closing') ? panelOf(item).offsetHeight : 0;
    item.classList.remove('is-closing');
    item.open = true;
    animate(item, from, panelOf(item).querySelector<HTMLElement>('.hero__acc-body')!.offsetHeight);
    accordions.forEach((other) => other !== item && close(other));
    holdInPlace(item);
  };

  accordions.forEach((item) =>
    item.querySelector('summary')!.addEventListener('click', (event) => {
      event.preventDefault();
      if (item.open && !item.classList.contains('is-closing')) close(item);
      else open(item);
    }),
  );

  single('.hero__color');
  single('.hero__size:not(:disabled)');
</script>

<style>
  /* On load the photo settles into place; it is visible from the first frame. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__stage {
      animation: hero-settle 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  @keyframes hero-settle {
    from {
      scale: 0.94;
    }
  }

  .hero {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background-color: var(--color-bg-dark);
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 0.375rem 0.75rem 0;
  }

  .hero__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 35.25rem;
    column-gap: 1.4375rem;
    align-items: start;
    flex: 1 1 auto;
    width: 100%;
    max-width: calc(var(--container-max) - 1.5rem);
    margin-inline: auto;
    padding: 1.25rem 1.25rem 1.375rem;
    border-radius: var(--radius-container) var(--radius-container) 0 0;
    background-color: var(--color-bg-white);
  }

  .hero__gallery {
    display: flex;
    gap: 2.0625rem;
  }

  .hero__thumbs {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-shrink: 0;
  }

  .hero__thumb {
    display: grid;
    place-items: center;
    width: 7.4375rem;
    aspect-ratio: 1;
    border-radius: var(--radius-panel);
    background-color: var(--color-bg-tile);
    outline: 1px solid transparent;
    outline-offset: -1px;
    transition: background-color var(--transition-base), outline-color var(--transition-base);
  }

  .hero__thumb img {
    transition: scale 0.45s cubic-bezier(0.33, 1, 0.68, 1);
  }

  .hero__thumbs .hero__thumb:focus-visible,
  .hero__colors .hero__color:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .hero__thumb[aria-selected='true'] {
    outline: 1px solid var(--color-primary);
    outline-offset: -1px;
  }

  .hero__stage {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    padding-top: 3.8125rem;
  }

  .hero__track {
    display: flex;
    max-width: 37.6875rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .hero__track::-webkit-scrollbar {
    display: none;
  }

  .hero__slide {
    flex: 0 0 100%;
    aspect-ratio: 3 / 2;
    scroll-snap-align: start;
  }

  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero__dots {
    display: none;
  }

  .hero__buy,
  .hero__more {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    background-color: var(--color-bg-panel);
  }

  /* Desktop: the buy box fills the right column; the reviews and the accordions sit
     under the gallery, so the two columns end together and nothing has to stick. */
  .hero__buy {
    grid-column: 2;
    grid-row: 1 / span 2;
    padding: 2.5rem;
    border-radius: var(--radius-panel);
  }

  .hero__more {
    grid-column: 1;
    grid-row: 2;
    margin-top: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-panel);
  }

  .hero__head {
    display: flex;
    flex-direction: column;
    gap: 1.0625rem;
  }

  .hero__rating {
    display: flex;
    align-items: center;
    gap: 0.8125rem;
    color: var(--color-text-strong);
  }

  .hero__rating :global(.stars) {
    gap: 0.5rem;
  }

  .hero__title {
    color: var(--color-primary);
  }

  .hero__price {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__now {
    color: var(--color-text-primary);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    height: 1.5rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-accent);
    color: var(--color-primary);
  }

  .hero__group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero__label,
  .hero__label-row {
    color: var(--color-text-strong);
  }

  .hero__label-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero__link {
    text-decoration: underline;
    text-underline-position: from-font;
    color: var(--color-text-strong);
    transition: color var(--transition-base), text-decoration-color var(--transition-base);
  }

  .hero__colors {
    display: flex;
    gap: 0.5rem;
  }

  .hero__color {
    display: grid;
    place-items: center;
    flex: 1 1 0;
    min-width: 0;
    height: 7.125rem;
    border-radius: var(--radius-panel);
    background-color: var(--color-bg-tile);
    outline: 1px solid transparent;
    outline-offset: -1px;
    transition: background-color var(--transition-base), outline-color var(--transition-base);
  }

  .hero__color img {
    width: var(--fit);
    opacity: 0.4;
    transition: opacity var(--transition-base), scale 0.45s cubic-bezier(0.33, 1, 0.68, 1);
  }

  .hero__color[aria-pressed='true'] {
    outline: 1px solid var(--color-primary);
    outline-offset: -1px;
    background-color: var(--color-bg-white);
  }

  .hero__color[aria-pressed='true'] img {
    opacity: 1;
  }

  .hero__sizes {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .hero__size {
