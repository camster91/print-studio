---
import { site } from '../config/site';
---

<dialog class="drawer" data-cart aria-labelledby="cart-title">
  <div class="drawer__panel">
    <div class="drawer__head">
      <h2 id="cart-title" class="display-s">Your bag (<span data-cart-count>0</span>)</h2>
      <button class="label-l" data-cart-close aria-label="Close bag">✕</button>
    </div>

    <div class="drawer__ship" data-ship>
      <p class="body-s" data-ship-text style="color:var(--ink)"></p>
      <div class="drawer__bar"><span data-ship-bar></span></div>
    </div>

    <ul class="drawer__lines" data-cart-lines></ul>

    <div class="drawer__empty" data-cart-empty>
      <p class="body-m">Your bag is empty.</p>
      <a href="/shop" class="btn btn--dark">Shop prints</a>
    </div>

    <div class="drawer__foot" data-cart-foot hidden>
      <div class="drawer__total"><span class="body-m" style="color:var(--ink)">Subtotal</span><span class="label-l" data-cart-subtotal>$0</span></div>
      <p class="body-s">Shipping or free Toronto pickup is chosen at checkout.</p>
      <button class="btn btn--primary btn--block" data-checkout>Checkout</button>
      <p class="mono-s drawer__secure">Secure checkout by Stripe · Cards · Apple Pay · Google Pay</p>
      <p class="body-s" data-has-mto hidden>Made-to-order items: we email a proof before printing. Nothing ships until you approve.</p>
      <p class="body-s drawer__error" role="alert" data-cart-error></p>
    </div>
    <p class="sr-only" role="status" data-cart-status></p>
  </div>
</dialog>

<template data-cart-line>
  <li class="line">
    <div class="line__thumb"></div>
    <div class="line__info">
      <p class="label-m" data-line-name></p>
      <p class="body-s" data-line-opts></p>
      <div class="line__qty">
        <button data-line-step="-1" aria-label="One fewer">–</button>
        <span data-line-qty></span>
        <button data-line-step="1" aria-label="One more">+</button>
        <button class="body-s" data-line-remove>Remove</button>
      </div>
    </div>
    <p class="label-m" data-line-price></p>
  </li>
</template>

<script>
  import { site } from '../config/site';
  import { getCart, setQuantity, checkout, type CartItem } from '../lib/cart';
  import { money, bySlug } from '../lib/products';
  import { productImages } from '../lib/images';

  const drawer = document.querySelector<HTMLDialogElement>('[data-cart]')!;
  const lines = drawer.querySelector<HTMLElement>('[data-cart-lines]')!;
  const tpl = document.querySelector<HTMLTemplateElement>('[data-cart-line]')!;
  const status = drawer.querySelector<HTMLElement>('[data-cart-status]')!;
  const errorEl = drawer.querySelector<HTMLElement>('[data-cart-error]')!;

  function paint(items: CartItem[]) {
    const count = items.reduce((n, i) => n + i.quantity, 0);
    const subtotal = items.reduce((n, i) => n + i.price * i.quantity, 0);
    document.querySelectorAll('[data-cart-count]').forEach((b) => (b.textContent = String(count)));
    drawer.querySelector('[data-cart-subtotal]')!.textContent = money(subtotal);
    (drawer.querySelector('[data-cart-empty]') as HTMLElement).hidden = items.length > 0;
    (drawer.querySelector('[data-cart-foot]') as HTMLElement).hidden = items.length === 0;
    (drawer.querySelector('[data-ship]') as HTMLElement).hidden = items.length === 0;
    (drawer.querySelector('[data-has-mto]') as HTMLElement).hidden = !items.some((i) => i.madeToOrder);
    const left = site.freeShippingFrom - subtotal;
    drawer.querySelector('[data-ship-text]')!.textContent = left > 0
      ? `Add ${money(left)} more for free shipping in Canada. Toronto pickup is always free.`
      : 'You get free shipping in Canada.';
    (drawer.querySelector('[data-ship-bar]') as HTMLElement).style.width = `${Math.min(100, (subtotal / site.freeShippingFrom) * 100)}%`;
    lines.replaceChildren(...items.map((item) => {
      const row = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const product = bySlug(item.slug);
      const src = product ? productImages(product,item.options)[0] : undefined;
      if (src) { const img=document.createElement('img'); img.src=src;img.alt=item.name;img.loading='lazy';row.querySelector('.line__thumb')!.append(img); if(src.startsWith('/renders/')) { const note=document.createElement('span');note.textContent='Preview image';row.querySelector('.line__thumb')!.append(note); } }
      if (!src) { const note=document.createElement('span');note.textContent='Photo coming soon';row.querySelector('.line__thumb')!.append(note); }
      row.querySelector('[data-line-name]')!.textContent = item.name;
      row.querySelector('[data-line-opts]')!.textContent = Object.values(item.options).filter(Boolean).join(' · ') + (item.files?.length ? ` · ${item.files.length} file(s)` : '');
      row.querySelector('[data-line-qty]')!.textContent = String(item.quantity);
      row.querySelector('[data-line-price]')!.textContent = money(item.price * item.quantity);
      row.querySelectorAll<HTMLElement>('[data-line-step]').forEach((b) => b.addEventListener('click', () => setQuantity(item.key, item.quantity + Number(b.dataset.lineStep))));
      row.querySelector('[data-line-remove]')!.addEventListener('click', () => { setQuantity(item.key, 0); status.textContent = `${item.name} removed.`; });
      return row;
    }));
  }

  const open = () => { if (!drawer.open) drawer.showModal(); };
  document.querySelectorAll('[data-cart-open]').forEach((b) => b.addEventListener('click', open));
  drawer.querySelectorAll('[data-cart-close]').forEach((b) => b.addEventListener('click', () => drawer.close()));
  drawer.addEventListener('click', (e) => { if (e.target === drawer) drawer.close(); });
  window.addEventListener('cart:change', (e) => paint((e as CustomEvent<CartItem[]>).detail));
  window.addEventListener('cart:open', open);
  paint(getCart());

  const btn = drawer.querySelector<HTMLButtonElement>('[data-checkout]')!;
  btn.addEventListener('click', async () => {
    errorEl.textContent = '';
    btn.disabled = true;
    btn.textContent = 'Opening secure checkout…';
    try {
      location.href = await checkout(getCart());
    } catch (err) {
      errorEl.textContent = (err as Error).message;
      btn.disabled = false;
      btn.textContent = 'Checkout';
    }
  });
</script>

<style>
  .drawer { position: fixed; inset: 0 0 0 auto; margin: 0; height: 100dvh; max-height: none; max-width: 100vw; width: min(480px, 100vw); border: 0; background: var(--paper); padding: 0; }
  .drawer[open] { animation: slide-in 350ms var(--ease); }
  .drawer::backdrop { background: rgb(20 20 20 / 0.45); }
  @keyframes slide-in { from { transform: translateX(100%); } }
  @media (prefers-reduced-motion: reduce) { .drawer[open] { animation: none; } }
  .drawer__panel { display: flex; flex-direction: column; gap: 20px; padding: 28px; min-height: 100%; }
  .drawer__head { display: flex; justify-content: space-between; align-items: center; }
  .drawer__ship { display: flex; flex-direction: column; gap: 8px; padding: 14px; border-radius: 12px; background: var(--surface); }
  .drawer__bar { height: 6px; border-radius: 3px; background: var(--grid); overflow: hidden; }
  .drawer__bar span { display: block; height: 100%; background: var(--accent); transition: width 400ms var(--ease); }
  .drawer__lines { display: flex; flex-direction: column; gap: 16px; }
  .line { display: grid; grid-template-columns: 72px minmax(0,1fr) auto; gap: 14px; padding-bottom: 16px; border-bottom: 1px solid var(--grid); }
  .line__thumb :global(img) {width:100%;height:100%;object-fit:cover;border-radius:12px} .line__thumb :global(span) {position:absolute;bottom:0;left:0;font-size:9px;background:white;padding:2px} .line__thumb {position:relative; width: 72px; height: 72px; border-radius: 12px; background: #e6e1d8; }
  .line__info { overflow-wrap:anywhere; display: flex; flex-direction: column; gap: 4px; }
  .line__qty { display: flex; align-items: center; gap: 12px; margin-top: 4px; }
  .line__qty button[data-line-step] { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--grid); }
  .line__qty [data-line-remove] { margin-left: 8px; text-decoration: underline; }
  .drawer__empty { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .drawer__foot { margin-top: auto; display: flex; flex-direction: column; gap: 12px; }
  .drawer__total { display: flex; justify-content: space-between; align-items: center; }
  .drawer__secure { text-align: center; color: var(--muted); }
  .drawer__error { color: #b42318; }
</style>
