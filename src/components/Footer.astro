---
import { site } from '../config/site';

const links = [
  { label: 'Refund policy', href: site.legal.refund },
  { label: 'Privacy policy', href: site.legal.privacy },
  { label: 'Terms of service', href: site.legal.terms },
];

const credit = { label: 'Temlis', href: 'https://temlis.com' };
---

<footer class="footer">
  <a class="footer__logo hit t-brand-lg" href="/" aria-label={site.name}>{site.name}</a>
  <nav class="footer__nav t-footer" aria-label="Legal">
    {links.map((link) => <a class="footer__link link-line" href={link.href}>{link.label}</a>)}
  </nav>
  <p class="footer__credit t-footer">©{new Date().getFullYear()} <a class="link-line" href={credit.href}>{credit.label}</a></p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 2rem 0.75rem;
    background-color: var(--color-bg-dark);
  }

  .footer__logo {
    color: var(--color-accent);
    transition: opacity var(--transition-base);
  }

  @media (min-width: 992px) and (hover: hover) and (pointer: fine) {
    .footer__logo:hover {
      opacity: 0.8;
    }
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 3rem;
    color: var(--color-text-white);
  }

  .footer__credit {
    color: var(--color-text-white);
  }

  /* On phones the legal links read like the size chips of the hero. */
  @media (max-width: 767px) {
    .footer {
      gap: 1.5rem;
      padding: 2.5rem var(--container-padding) 2rem;
    }

    .footer__nav {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      width: 100%;
    }

    .footer__link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.75rem;
      padding-inline: 0.25rem;
      border-radius: var(--radius-sm);
      background: var(--color-bg-white);
      color: var(--color-primary);
      font-family: var(--font-heading);
      font-size: 0.875rem;
      text-align: center;
      text-transform: uppercase;
    }
  }
</style>
