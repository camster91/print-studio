---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container">
    <div class="footer__top">
      <div class="stack gap-16 footer__brand">
        <a href="/" class="wordmark wordmark--light footer__mark">Layer<span>line</span></a>
        <p class="body-m">Made to order in Toronto. Local pickup in the east end, shipping across Canada.</p>
      </div>
      <nav class="footer__cols" aria-label="Footer">
        <div class="stack gap-12">
          <p class="mono-s kicker">Shop</p>
          <a href="/shop?type=in-stock">Ready to ship</a>
          <a href="/shop?type=made-to-order">Personalise it</a>
          <a href="/shop?category=gifts">Gifts</a>
          <a href="/shop?category=garage">Garage</a>
        </div>
        <div class="stack gap-12">
          <p class="mono-s kicker">Studio</p>
          <a href="/custom">Custom builds</a>
          <a href="/business">For business</a>
          <a href="/about">About</a>
          <a href="/#faq">FAQ</a>
        </div>
        <div class="stack gap-12">
          <p class="mono-s kicker">Contact</p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.instagram && <a href={site.instagram} rel="noopener">Instagram</a>}
          {site.etsy && <a href={site.etsy} rel="noopener">Etsy</a>}
        </div>
      </nav>
    </div>
    <div class="footer__bottom mono-s">
      <span>© {year} {site.name} · Toronto, ON</span>
      <span class="row gap-16"><a href={site.legal.refund}>Shipping & returns</a><a href={site.legal.privacy}>Privacy</a><a href={site.legal.terms}>Terms</a></span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--ink); padding-block: 72px 32px; }
  .footer a { color: var(--paper); }
  .footer a:hover { color: var(--accent); }
  .footer__top { display: flex; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .footer__brand { max-width: 360px; }
  .footer__mark { font-size: 3rem; }
  .footer__cols { display: flex; gap: 80px; flex-wrap: wrap; }
  .footer__bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 56px; padding-top: 24px; border-top: 1px solid rgb(244 242 238 / 0.15); color: var(--grid); }
  .footer__bottom a { color: var(--grid); }
  @media (max-width: 767px) { .footer__cols { gap: 40px; } }
</style>
