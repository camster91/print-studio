---
import Stars from './Stars.astro';
import { noOrphan } from '../lib/typography';

const reviews = [
  {
    quote: '“Super comfortable and incredibly lightweight. I can wear them all day without thinking about my feet.”',
    name: 'Alex M.',
  },
  { quote: '“Simple, clean, and goes with everything. These have quickly become my everyday shoes.”', name: 'Jordan K.' },
  { quote: '“The cushioning feels great and they’re comfortable right out of the box.”', name: 'Chris L.' },
  { quote: '“Light enough for long walks and clean enough for the office. I already ordered a second pair.”', name: 'Taylor R.' },
];
---

<section class="reviews">
  <div class="reviews__inner container container--padded">
    <div class="reviews__aside">
      <div class="reviews__score" data-reveal>
        <h2 class="reviews__title t-display">4.9/5.0</h2>
        <p class="t-body">80,000+ reviews</p>
      </div>
      <div class="reviews__arrows" data-reveal>
        <button class="reviews__arrow reviews__arrow--prev hit" type="button" aria-label="Previous review">
          <img src="/assets/icons/arrow-next.svg" alt="" width="32" height="32" />
        </button>
        <button class="reviews__arrow reviews__arrow--next hit" type="button" aria-label="Next review">
          <img src="/assets/icons/arrow-next.svg" alt="" width="32" height="32" />
        </button>
      </div>
    </div>
    <div class="reviews__slider" aria-label="Customer reviews" data-reveal>
      <ul class="reviews__track" tabindex="0">
        {
          reviews.map((review) => (
            <li class="reviews__slide">
              <article class="reviews__card">
                <Stars src="/assets/icons/star.svg" />
                <blockquote class="reviews__quote t-card">{noOrphan(review.quote)}</blockquote>
                <p class="reviews__name t-meta">{review.name}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // The cards scroll sideways with a finger or a trackpad and snap to the left edge; with a
  // mouse they can be dragged. The arrows move one card at a time and dim at either end.
  const track = document.querySelector<HTMLElement>('.reviews__track');
  const prev = document.querySelector<HTMLButtonElement>('.reviews__arrow--prev');
  const next = document.querySelector<HTMLButtonElement>('.reviews__arrow--next');

  if (track && prev && next) {
    const smooth = matchMedia('(prefers-reduced-motion: no-preference)').matches ? 'smooth' : 'auto';
    const card = () => track.querySelector<HTMLElement>('.reviews__slide')?.offsetWidth ?? track.clientWidth;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -card(), behavior: smooth }));
    next.addEventListener('click', () => track.scrollBy({ left: card(), behavior: smooth }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    // Mouse drag: follow the pointer, then let the snap settle on the nearest card.
    let startX = 0;
    let startLeft = 0;
    let dragging = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      startX = e.clientX;
      startLeft = track.scrollLeft;
      track.classList.add('is-dragging');
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener('pointermove', (e) => {
      if (dragging) track.scrollLeft = startLeft - (e.clientX - startX);
    });
    const release = () => {
      if (!dragging) return;
      dragging = false;
      const left = Math.round(track.scrollLeft / card()) * card();
      track.classList.remove('is-dragging');
      track.scrollTo({ left, behavior: smooth });
    };
    track.addEventListener('pointerup', release);
    track.addEventListener('pointercancel', release);
  }
</script>

<style>
  .reviews {
    overflow-x: clip;
  }

  .reviews__inner {
    display: flex;
    gap: 1.5rem;
    padding-block: 3.75rem;
  }

  .reviews__aside {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    width: 19.5rem;
  }

  .reviews__score {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .reviews__title {
    color: var(--color-primary);
  }

  .reviews__arrows {
    display: flex;
    gap: 0.75rem;
  }

  .reviews__arrow {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    transition: opacity var(--transition-base);
  }

  .reviews__arrow img {
    rotate: 90deg;
  }

  .reviews__arrow--prev img {
    rotate: -90deg;
  }

  .reviews__arrow:disabled {
    opacity: 0.65;
    cursor: default;
  }

  .reviews__slider {
    flex: 1 1 0;
    min-width: 0;
    margin-inline: -0.75rem;
  }

  /* The track runs on to the edge of the window, so the next card peeks in. */
  .reviews__track {
    --bleed: calc(var(--container-padding) + max(0px, (100vw - var(--container-max)) / 2));
    display: flex;
    margin-right: calc(-1 * var(--bleed));
    padding-right: var(--bleed);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }

  .reviews__track::-webkit-scrollbar {
    display: none;
  }

  .reviews__track:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .reviews__track.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .reviews__slide {
    flex: none;
    width: calc(100% / 3);
    padding-inline: 0.75rem;
    scroll-snap-align: start;
  }

  .reviews__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
    min-height: 25.1875rem;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    background-color: var(--color-bg-panel);
    user-select: none;
  }

  .reviews__card :global(.stars) {
    gap: 0.5rem;
  }

  .reviews__quote {
    color: var(--color-primary);
  }

  .reviews__name {
    color: var(--color-text-strong);
  }

  @media (min-width: 992px) and (hover: hover) and (pointer: fine) {
    .reviews__arrow:not(:disabled):hover {
      opacity: 0.8;
    }
  }

  @media (max-width: 991px) {
    .reviews__inner {
      flex-direction: column;
      gap: 2.5rem;
    }

    .reviews__aside {
      flex-direction: row;
      align-items: flex-end;
      width: auto;
    }

    .reviews__track {
      margin-left: calc(-1 * var(--bleed));
      padding-left: var(--bleed);
      scroll-padding-inline-start: var(--bleed);
    }

    .reviews__slide {
      width: calc(100% / 2.3);
    }

    .reviews__card {
      min-height: 20rem;
    }

    .reviews__quote {
      line-height: 1.6 !important;
    }
  }

  @media (max-width: 767px) {
    .reviews__inner {
      padding-block: 3rem;
    }

    .reviews__slide {
      width: calc(100% / 1.6);
      padding-inline: 0.5rem;
    }

    .reviews__slider {
      margin-left: -0.5rem;
    }

    .reviews__card {
      justify-content: flex-start;
      min-height: 0;
    }

    .reviews__name {
      margin-top: auto;
    }
  }

  @media (max-width: 479px) {
    .reviews__slide {
      width: calc(100% / 1.15);
    }
  }
</style>
