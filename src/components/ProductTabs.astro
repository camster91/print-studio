---
import Stars from './Stars.astro';
import { noOrphan } from '../lib/typography';

const tabs = [
  { id: 'review', label: 'Expert Review' },
  { id: 'comparison', label: 'Comparison' },
  { id: 'size-guide', label: 'Size guide' },
];

const comparison = [
  ['Weight', 'Often feels bulky', 'Lightweight construction'],
  ['Comfort', 'Basic cushioning', 'Cushioned everyday'],
  ['Flexibility', 'Can feel stiff', 'Designed for natural movement'],
];

const sizes = [
  ['6', '39', '5', '24.5 cm'],
  ['7', '40', '6', '25.2 cm'],
  ['8', '41', '7', '25.9 cm'],
  ['9', '42', '8', '26.6 cm'],
  ['10', '43', '9', '27.3 cm'],
];
---

<div class="tabs" id="product-tabs" data-reveal>
  <div class="tabs__list" role="tablist" aria-label="Product information">
    {
      tabs.map((tab, i) => (
        <button
          class="tabs__tab hit hit--tight t-tag"
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={tab.id}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div class="tabs__panel tabs__panel--review" role="tabpanel" id="panel-review" aria-labelledby="tab-review">
    <Stars src="/assets/icons/star.svg" size={12} />
    <blockquote class="tabs__quote t-tag">
      {noOrphan('“Super comfortable and incredibly lightweight. I can wear them all day without thinking about my feet.”')}
    </blockquote>
    <p class="tabs__name t-meta">Alex M.</p>
  </div>

  <div class="tabs__panel" role="tabpanel" id="panel-comparison" aria-labelledby="tab-comparison" hidden>
    <table class="tabs__table tabs__table--compare">
      <thead>
        <tr class="t-tag-sm">
          <th scope="col"><span class="sr-only">Feature</span></th>
          <th scope="col">Traditional Sneakers</th>
          <th scope="col" class="is-brand">Sola Stride</th>
        </tr>
      </thead>
      <tbody class="t-cell">
        {
          comparison.map(([feature, other, ours]) => (
            <tr>
              <th scope="row">{feature}</th>
              <td class="is-muted">{other}</td>
              <td class="is-brand">{noOrphan(ours)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="tabs__panel" role="tabpanel" id="panel-size-guide" aria-labelledby="tab-size-guide" hidden>
    <table class="tabs__table tabs__table--sizes">
      <thead>
        <tr class="t-tag-sm">
          <th scope="col">US</th>
          <th scope="col">EU</th>
          <th scope="col">UK</th>
          <th scope="col" class="is-brand">Foot Length</th>
        </tr>
      </thead>
      <tbody class="t-cell">
        {
          sizes.map((row) => (
            <tr>
              {row.map((cell) => (
                <td>{cell}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.tabs');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.tabs__tab')];

    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((other) => {
        const active = other === tab;
        other.setAttribute('aria-selected', String(active));
        other.tabIndex = active ? 0 : -1;
        root.querySelector<HTMLElement>(`#${other.getAttribute('aria-controls')}`)!.hidden = !active;
      });
      const list = tab.parentElement!;
      const left = tab.offsetLeft - list.offsetLeft;
      if (left < list.scrollLeft || left + tab.offsetWidth > list.scrollLeft + list.clientWidth) {
        list.scrollTo({ left: left - (list.clientWidth - tab.offsetWidth) / 2, behavior: 'smooth' });
      }
      if (focus) tab.focus({ preventScroll: true });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length], true);
      });
    });

    document.querySelectorAll<HTMLElement>('[data-open-tab]').forEach((trigger) =>
      trigger.addEventListener('click', () => {
        const tab = tabs.find((t) => t.dataset.tab === trigger.dataset.openTab);
        if (!tab) return;
        select(tab);
        root.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }),
    );
  }
</script>

<style>
  .tabs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-white);
    scroll-margin: 2rem;
  }

  .tabs__list {
    display: flex;
    margin-inline: -0.5rem;
    padding-inline: 0.5rem;
    overflow-x: auto;
    scroll-padding-inline: 0.5rem;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .tabs__list::-webkit-scrollbar {
    display: none;
  }

  .tabs__tab {
    flex: 1 0 auto;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-primary-faded);
    white-space: nowrap;
    transition: background-color var(--transition-base), color var(--transition-base);
  }

  .tabs__tab[aria-selected='true'] {
    background-color: var(--color-primary);
    color: var(--color-accent);
  }

  @media (min-width: 992px) and (hover: hover) and (pointer: fine) {
    .tabs__tab[aria-selected='false']:hover {
      background-color: var(--color-bg-tile);
      color: var(--color-primary);
    }
  }

  .tabs__panel--review {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1rem;
  }

  .tabs__panel[hidden] {
    display: none;
  }

  .tabs__panel--review :global(.stars) {
    gap: 0.5rem;
  }

  .tabs__quote {
    color: var(--color-primary);
  }

  .tabs__name {
    color: var(--color-text-strong);
  }

  .tabs__table {
    width: calc(100% - 1rem);
    margin: 0 0.5rem 0.5rem;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .tabs__table tr {
    border-bottom: 1px solid var(--color-border);
  }

  .tabs__table th,
  .tabs__table td {
    padding: 1rem 0.25rem;
    font-weight: inherit;
    text-align: center;
    vertical-align: middle;
    color: var(--color-text-primary);
  }

  .tabs__table--compare th[scope='row'] {
    text-align: left;
  }

  .tabs__table .is-muted {
    color: var(--color-text-secondary);
  }

  .tabs__table .is-brand {
    color: var(--color-primary);
  }
</style>
