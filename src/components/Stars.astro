---
interface Props {
  count?: number;
  src: string;
  size?: number;
}

const { count = 5, src, size = 16 } = Astro.props;
---

<span class="stars" data-reveal="stars" role="img" aria-label={`${count} out of 5 stars`}>
  {Array.from({ length: count }, () => <img src={src} alt="" width={size} height={size} />)}
</span>

<style>
  .stars {
    display: inline-flex;
    gap: 0.25rem;
  }
</style>
