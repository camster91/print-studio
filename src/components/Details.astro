---
import { noOrphan } from '../lib/typography';

const specs = ['Everyday Wear', 'True to Size', 'Engineered Mesh', 'Lightweight Foam', 'Rubber'];
---

<section class="details" id="details">
  <div class="details__inner container container--padded">
    <div class="details__media" data-reveal="image">
      <img
        src="/assets/images/details-lacing.avif"
        srcset="/assets/images/details-lacing-768.avif 768w, /assets/images/details-lacing.avif 1024w"
        sizes="(min-width: 992px) 50vw, (min-width: 480px) 45vw, 100vw"
        alt="Person lacing up green Sola Stride sneakers on a green floor"
        width="1024"
        height="1536"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="details__body">
      <div class="details__head">
        <h2 class="details__title t-display" data-reveal="lines">DETAILS</h2>
        <p class="t-body" data-reveal>
          {noOrphan('Every material is picked to feel light, breathe easy and hold up to daily wear.')}
        </p>
      </div>
      <ol class="details__list">
        {
          specs.map((spec, i) => (
            <li class="details__item" data-reveal>
              <span class="details__index t-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="details__spec t-title">{spec}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .details__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
    padding-block: 3.75rem;
  }

  .details__media {
    position: relative;
    min-height: 20rem;
    overflow: clip;
    border-radius: var(--radius-container);
  }

  .details__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .details__body {
    display: flex;
    flex-direction: column;
    gap: 6.25rem;
  }

  .details__head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 30.25rem;
  }

  .details__title {
    color: var(--color-primary);
  }

  .details__list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .details__item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .details__index {
    flex-shrink: 0;
    width: 1.5rem;
    color: var(--color-text-secondary);
  }

  .details__spec {
    color: var(--color-text-primary);
  }

  @media (max-width: 991px) {
    .details__inner {
      grid-template-areas:
        'head head'
        'media list';
      gap: 3rem 2rem;
    }

    .details__body {
      display: contents;
    }

    .details__head {
      grid-area: head;
      max-width: none;
    }

    .details__media {
      grid-area: media;
      min-height: 0;
    }

    .details__list {
      grid-area: list;
    }
  }

  @media (max-width: 767px) {
    .details__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2.5rem 1.5rem;
      padding-block: 3rem;
    }

    .details__list {
      gap: 1.5rem;
    }
  }

  @media (max-width: 479px) {
    .details__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'media'
        'list';
      gap: 2.5rem;
    }

    .details__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
