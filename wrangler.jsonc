{
  // Static Astro site + a small Worker for /api/* (Stripe checkout, uploads, quote requests).
  "name": "layerline",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "layerline.ca", "custom_domain": true },
    { "pattern": "www.layerline.ca", "custom_domain": true }
  ],
  "vars": {
    "FREE_SHIPPING_FROM": "100",
    "SHIPPING_CANADA": "12",
    // New custom/business requests are emailed here (must be a verified Email Routing address).
    "NOTIFY_TO": "cameron@ashbi.ca",
    "NOTIFY_FROM": "requests@layerline.ca"
  },
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "layerline-uploads" }],
  "send_email": [{ "name": "SEND_EMAIL", "destination_address": "cameron@ashbi.ca" }]
  // Secret (never commit), set in the Cloudflare dashboard or: npx wrangler secret put STRIPE_SECRET_KEY
}
